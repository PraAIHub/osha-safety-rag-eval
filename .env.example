# Copy this file to .env and fill in your key. Nothing else here needs changing
# to reproduce the numbers in report.md.
#
# NOTE: `fetch_osha.py` and `rag.py ingest` need NO key at all — the corpus comes
# from eCFR's public API and the embeddings are computed locally by a small
# open-source model. Only `rag.py ask` and the LLM-judged half of `rag.py eval`
# call a hosted model.

OPENAI_API_KEY=paste-your-key-here

# Any OpenAI-compatible endpoint works. This project was built and measured
# against the Modern AI Pro class proxy, which is the default when unset:
#   OPENAI_BASE_URL=https://learn.modernaipro.com/api/llm/v1
# For stock OpenAI, drop the line entirely and set OPENAI_MODEL below.
# OPENAI_BASE_URL=https://api.openai.com/v1

# The class proxy picks the model and ignores this value; it defaults to "mai".
# Against any other endpoint, set a real model id here.
# OPENAI_MODEL=gpt-4o-mini
